# 家庭点餐系统后端配置示例
# 复制本文件为 .env 并填写真实值；.env 已被 .gitignore 排除，不会上传

# MySQL 连接串（必填）
DATABASE_URL=mysql://user:password@127.0.0.1:3306/family_dining

# 服务监听
HOST=0.0.0.0
PORT=8080

# 跨域来源
CORS_ORIGIN=*

# 前端静态资源目录（相对 backend 目录）
STATIC_DIR=../frontend/dist

# 日志级别
RUST_LOG=family_dining_api=info,actix_web=info

# JWT 鉴权密钥（生产环境务必改为随机长字符串）
AUTH_SECRET=change-me-to-a-random-secret
AUTH_EXPIRE_DAYS=30

# 快递100（后期接入物流轨迹查询时使用；两项都填写后才会启用，留空不影响取件码记录功能）
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=
