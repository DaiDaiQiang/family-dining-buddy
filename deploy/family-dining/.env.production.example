# =====================================================================
#  家庭点餐系统 · 正式环境配置模板
#  用法：复制本文件为 .env，按下方说明修改后，与 bin/family-dining-api.exe
#        放在同一目录启动。后端会用当前工作目录下的 .env 覆盖内置默认值。
# =====================================================================

# ---- 数据库连接（必改）----
# 正式环境务必使用独立账号，不要用 root。
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://family_dining_app:改成你的密码@127.0.0.1:3306/family_dining

# ---- 监听地址与端口 ----
# 内网部署默认 0.0.0.0:8080 即可；如需改端口，改 PORT 并同步防火墙放行。
HOST=0.0.0.0
PORT=8080

# ---- 跨域来源 ----
# 前后端同源部署（后端托管 dist）时无需改；若前后端分离再按需收敛为具体域名。
CORS_ORIGIN=*

# ---- 前端静态目录（重要：正式环境用绝对路径，避免工作目录错乱）----
# 指向打包出来的 dist 目录（与本 .env 平级的 dist）。
STATIC_DIR=D:/family-dining/dist

# ---- 上传目录（重要：绝对路径，头像图存这里）----
UPLOAD_DIR=D:/family-dining/uploads

# ---- 数据库连接池（可选）----
DB_MAX_CONNECTIONS=10
DB_CONNECT_RETRIES=3

# ---- 鉴权密钥（必改！）----
# 这是 JWT 签名密钥。务必改成一段随机长字符串，否则换台机器后令牌可被伪造。
# 生成随机值示例：openssl rand -hex 32
AUTH_SECRET=请改成一段至少32位的随机字符串

# 登录令牌有效期（天），默认 30
AUTH_EXPIRE_DAYS=30

# ---- 快递100（可选，暂未启用物流查询）----
KUAIDI100_KEY=
KUAIDI100_CUSTOMER=

# ---- 日志 ----
RUST_LOG=family_dining_api=info,actix_web=info
